import { useState } from 'react'
import { Link } from 'react-router-dom'
import { useAppStore } from '../../store/useAppStore'
import PublicNav from '../../components/layout/PublicNav'

export default function Portal() {
  const addDeal = useAppStore(s => s.addDeal)
  // form state for public submission (no reliance on internal wizard for public users)
  const [form, setForm] = useState({
    address: '', city: '', state: '', zip: '', type: 'SFH', askingPrice: '', arv: '', rehab: '',
    name: '', email: '', phone: '', role: 'Wholesaler', isOwner: true, consent: false
  })
  const [honeypot, setHoneypot] = useState('') // anti-spam: hidden field; if filled by bot, reject
  const [lastSubmit, setLastSubmit] = useState<number>(0) // simple client rate limit
  const [submitted, setSubmitted] = useState(false)
  const [submissionId, setSubmissionId] = useState('')
  const [error, setError] = useState('')

  const updateForm = (k: string, v: any) => setForm(prev => ({ ...prev, [k]: v }))

  return (
    <div className="min-h-screen bg-[#0A0C12]">
      <PublicNav />
      <div className="max-w-3xl mx-auto px-6 pt-6">
        <div className="flex justify-between items-center mb-6">
          <div className="text-sm text-[#8B92A3]">Public Submission Portal — secure intake for partners, wholesalers and small dispo operators</div>
          <Link to="/login" className="text-sm text-[#22C55E] hover:underline">Sign In</Link>
        </div>

        <div className="text-center mb-8">
          <div className="inline px-4 py-1 bg-[#22C55E]/10 text-[#22C55E] rounded text-xs font-semibold tracking-widest mb-3">PUBLIC SUBMISSION PORTAL</div>
          <h1 className="text-4xl font-semibold tracking-tight">Submit a Deal</h1>
          <p className="text-[#8B92A3] mt-2">Submit your deal once. We’ll review the details, check for missing information, and organize it for qualified buyer outreach.</p>
        </div>

        {/* Trust Header */}
        <div className="card p-4 mb-6 text-sm bg-[#12151F] border border-[#252A38]">
          <strong>Trusted by professional dispo teams.</strong> We only collect the information needed to properly review, match, and market your opportunity to qualified buyers.
        </div>

        {/* Who Should Submit */}
        <div className="mb-6">
          <div className="font-medium mb-2">Who Should Submit?</div>
          <div className="grid grid-cols-2 md:grid-cols-3 gap-2 text-sm">
            {['Property Owners', 'Wholesalers', 'Real Estate Agents', 'JV Partners', 'Dispo Operators'].map(role => (
              <div key={role} className="panel p-3 text-center">{role}</div>
            ))}
          </div>
        </div>

        {/* Real public submission form - focused, validated, anti-spam, stores as Submitted deal visible in admin Submissions */}
        <div className="card p-8">
          <div className="mb-4 text-sm text-[#8B92A3]">Submit your deal for review. We’ll check details, organize, and match to qualified buyers. All fields required unless noted.</div>

          {error && <div className="mb-3 text-sm text-red-400 bg-red-900/20 p-2 rounded">{error}</div>}

          <form onSubmit={(e) => {
            e.preventDefault()
            setError('')

            // anti-spam: honeypot
            if (honeypot) { setError('Submission blocked.'); return }

            // rate limit ~30s between public submits (client side)
            const now = Date.now()
            if (now - lastSubmit < 30000) { setError('Please wait a moment before submitting another deal.'); return }

            // basic validation
            if (!form.address || !form.city || !form.state || !form.email || !form.phone || !form.consent) {
              setError('Please complete all required fields and consent.'); return
            }
            if (!/^\S+@\S+\.\S+$/.test(form.email)) { setError('Enter a valid email.'); return }
            if (!form.askingPrice && !form.arv) { setError('Provide at least Asking Price or ARV.'); return }

            // build deal for storage (appears in admin Deal Submissions via status=Submitted)
            const deal = addDeal({
              status: 'Submitted',
              source: 'Public Portal',
              submitter: {
                name: form.name || 'Public Submitter',
                email: form.email,
                phone: form.phone,
                role: form.role,
                isOwner: !!form.isOwner,
                consent: true
              },
              property: {
                address: form.address,
                city: form.city,
                state: form.state,
                zip: form.zip || '',
                type: form.type as any,
                strategy: 'Wholesale',
                occupancy: 'Vacant'
              },
              pricing: {
                askingPrice: form.askingPrice ? Number(form.askingPrice) : undefined,
                arv: form.arv ? Number(form.arv) : undefined,
                rehab: form.rehab ? Number(form.rehab) : undefined
              },
              debt: { owed: 0, liens: 0, behind: 0 },
              condition: { repairs: form.rehab ? Number(form.rehab) : 0, scope: '' },
              docs: []
            } as any)

            const id = deal?.id || ('SUB-' + Date.now().toString(36).toUpperCase())
            setSubmissionId(id)
            setLastSubmit(now)
            setSubmitted(true)
            // do not auto set user or navigate to app - public submitter stays public
          }} className="space-y-4">

            {/* Honeypot anti-spam - hidden from users, bots often fill it */}
            <input type="text" value={honeypot} onChange={e => setHoneypot(e.target.value)} className="hidden" tabIndex={-1} autoComplete="off" />

            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <div className="text-xs text-[#8B92A3] mb-1">PROPERTY ADDRESS *</div>
                <input className="input" value={form.address} onChange={e=>updateForm('address',e.target.value)} required placeholder="123 Main St" />
              </div>
              <div>
                <div className="text-xs text-[#8B92A3] mb-1">CITY *</div>
                <input className="input" value={form.city} onChange={e=>updateForm('city',e.target.value)} required />
              </div>
              <div>
                <div className="text-xs text-[#8B92A3] mb-1">STATE *</div>
                <input className="input" value={form.state} onChange={e=>updateForm('state',e.target.value)} required maxLength={2} placeholder="TX" />
              </div>
              <div>
                <div className="text-xs text-[#8B92A3] mb-1">ZIP</div>
                <input className="input" value={form.zip} onChange={e=>updateForm('zip',e.target.value)} />
              </div>
            </div>

            <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
              <div>
                <div className="text-xs text-[#8B92A3] mb-1">PROPERTY TYPE</div>
                <select className="input" value={form.type} onChange={e=>updateForm('type',e.target.value)}>
                  <option>SFH</option><option>Multi</option><option>Condo</option><option>Land</option><option>Commercial</option>
                </select>
              </div>
              <div>
                <div className="text-xs text-[#8B92A3] mb-1">ASKING / CONTRACT PRICE</div>
                <input className="input" type="number" value={form.askingPrice} onChange={e=>updateForm('askingPrice',e.target.value)} placeholder="250000" />
              </div>
              <div>
                <div className="text-xs text-[#8B92A3] mb-1">ARV (after repair value)</div>
                <input className="input" type="number" value={form.arv} onChange={e=>updateForm('arv',e.target.value)} placeholder="320000" />
              </div>
            </div>

            <div>
              <div className="text-xs text-[#8B92A3] mb-1">REHAB / REPAIR ESTIMATE (optional)</div>
              <input className="input" type="number" value={form.rehab} onChange={e=>updateForm('rehab',e.target.value)} placeholder="45000" />
            </div>

            <div className="border-t border-[#252A38] pt-4 mt-2">
              <div className="font-medium mb-2 text-sm">Your Information (for review & follow-up)</div>
              <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <div className="text-xs text-[#8B92A3] mb-1">YOUR NAME *</div>
                  <input className="input" value={form.name} onChange={e=>updateForm('name',e.target.value)} required />
                </div>
                <div>
                  <div className="text-xs text-[#8B92A3] mb-1">ROLE</div>
                  <select className="input" value={form.role} onChange={e=>updateForm('role',e.target.value)}>
                    <option>Wholesaler</option><option>Property Owner</option><option>Real Estate Agent</option><option>JV Partner</option><option>Dispo Operator</option>
                  </select>
                </div>
                <div>
                  <div className="text-xs text-[#8B92A3] mb-1">EMAIL *</div>
                  <input className="input" type="email" value={form.email} onChange={e=>updateForm('email',e.target.value)} required />
                </div>
                <div>
                  <div className="text-xs text-[#8B92A3] mb-1">PHONE *</div>
                  <input className="input" value={form.phone} onChange={e=>updateForm('phone',e.target.value)} required placeholder="(555) 123-4567" />
                </div>
              </div>
              <label className="flex items-start gap-2 mt-3 text-sm">
                <input type="checkbox" checked={form.consent} onChange={e=>updateForm('consent',e.target.checked)} required className="mt-1" />
                <span>I consent to having this deal reviewed and matched to buyers inside Deal Blast Pro. I understand this is not a listing or guarantee of sale.</span>
              </label>
            </div>

            <button type="submit" className="btn btn-green w-full py-3 text-base mt-2">Submit Deal for Review</button>

            <div className="text-xs text-center text-[#8B92A3]">
              We do not sell your information. Used only for review and buyer-matching.
            </div>
          </form>
        </div>

        {/* Success splash - required post-submission flow (not small inline msg) */}
        {submitted && (
          <div className="fixed inset-0 bg-black/70 z-[200] flex items-center justify-center p-4" onClick={() => { /* prevent accidental close */ }}>
            <div className="card max-w-md w-full p-8 text-center" onClick={e=>e.stopPropagation()}>
              <div className="text-3xl font-semibold text-[#22C55E] mb-2">Deal Submitted Successfully</div>
              <div className="text-[#C5CAD6] mb-4">Thanks, we received your deal. Marcel’s team will review it shortly.</div>
              <div className="text-sm mb-6">Submission ID: <span className="font-mono text-[#E6E8EE]">{submissionId}</span></div>

              <div className="space-y-2">
                <button onClick={() => {
                  // Submit Another: clear form, hide splash, stay on /portal form
                  setForm({ address: '', city: '', state: '', zip: '', type: 'SFH', askingPrice: '', arv: '', rehab: '', name: '', email: '', phone: '', role: 'Wholesaler', isOwner: true, consent: false })
                  setHoneypot('')
                  setSubmitted(false)
                  setSubmissionId('')
                  setError('')
                }} className="btn btn-green w-full">Submit Another Deal</button>

                <Link to="/" className="btn btn-ghost w-full block">Exit</Link>

                <Link to="/pricing" className="btn btn-ghost w-full block">Sign Up / Choose a Plan</Link>
              </div>

              <div className="mt-4 text-[10px] text-[#8B92A3]">Estimated review: 24-48 hours. Check email for updates.</div>
            </div>
          </div>
        )}

        <div className="mt-6 text-xs text-center text-[#8B92A3]">Questions? Use the Contact page or submit your deal details through the portal.</div>

        <footer className="border-t border-[#252A38] mt-12 py-8 text-center text-xs text-[#8B92A3]">
          House Buyer Investments • Deal Blast Pro<br />
          <Link to="/pricing" className="hover:text-white">Pricing</Link> · 
          <Link to="/portal" className="hover:text-white">Submit Deal</Link> · 
          <Link to="/contact" className="hover:text-white">Contact</Link> · 
          <Link to="/privacy" className="hover:text-white">Privacy</Link> · 
          <Link to="/terms" className="hover:text-white">Terms</Link> · 
          <Link to="/security" className="hover:text-white">Security</Link>
        </footer>
      </div>
    </div>
  )
}
