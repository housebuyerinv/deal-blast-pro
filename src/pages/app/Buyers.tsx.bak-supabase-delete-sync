  const formatBuyerDisplayName = (value: any) => {
    const raw = String(value || '').trim()
    if (!raw) return ''

    const companySuffixes = new Set(['llc', 'inc', 'corp', 'co', 'lp', 'llp', 'pllc'])
    const forceUpper = new Set(['llc', 'inc', 'usa', 'rei', 'pof', 'gkw', 'des'])

    return raw
      .replace(/[_./-]+/g, ' ')
      .replace(/\s+/g, ' ')
      .split(' ')
      .filter(Boolean)
      .map((part) => {
        const clean = part.trim()
        const lower = safeLower(clean)

        if (forceUpper.has(lower)) return lower.toUpperCase()
        if (companySuffixes.has(lower)) return lower.toUpperCase()

        return lower
          .split(/(['-])/)
          .map((piece: any) => {
            if (piece === '-' || piece === "'") return piece
            if (!piece) return piece
            return piece.charAt(0).toUpperCase() + piece.slice(1)
