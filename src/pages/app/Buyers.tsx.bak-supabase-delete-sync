    const isCreative = /seller\s*financ(?:e|ing)|owner\s*financ(?:e|ing)|subto|subject\s*to|creative|wrap|lease\s*option|rent\s*to\s*own|rto|novation|balloon|down\s*payment|interest/i.test(combined)
