# Names only. Store values in an ignored local .env.buyermatch-staging file or secret manager.
# Vercel: Preview, branch codex/buyermatch-network ONLY. Never set privileged VITE_* variables.
BM_ENVIRONMENT=staging
BM_STAGING_PROJECT_REF=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
BUYERMATCH_IDENTITY_KEY=
DEALBLAST_OWNER_ADMIN_EMAILS=
BM_APP_ORIGIN=
BM_RESPONSE_SECRET=
BM_WORKER_SECRET=
BM_DELIVERY_MODE=mock
BM_CHECKOUT_ENABLED=false
BM_STRIPE_TEST_SECRET_KEY=
DBP_REQUIRE_VERSIONED_PLATFORM_AGREEMENTS=false
# Only needed with BM_DELIVERY_MODE=resend-test; recipients are hardcoded to Resend's test sink.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=Deal Blast Pro <onboarding@resend.dev>
# Supabase Edge Function secrets ONLY; SUPABASE_URL/service-role are provided by Supabase there.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BM_RESEND_WEBHOOK_SECRET=
# Local setup/seed/verification only, never needed by the frontend or Vercel functions.
BM_STAGING_DATABASE_URL=
BM_DATABASE_CA_FILE=
BM_STAGING_CONFIRM=I_HAVE_VERIFIED_THIS_IS_NOT_PRODUCTION
BM_TEST_USER_EMAIL=user@example.invalid
BM_TEST_OTHER_EMAIL=other@example.invalid
BM_TEST_ADMIN_EMAIL=admin@example.invalid
BM_TEST_USER_PASSWORD=
BM_TEST_OTHER_PASSWORD=
BM_TEST_ADMIN_PASSWORD=
# Local verification only, if Vercel Deployment Protection is enabled.
VERCEL_AUTOMATION_BYPASS_SECRET=
