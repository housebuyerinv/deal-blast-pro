# Deal Blast Pro - Environment Configuration
# 
# Current demo works with zero configuration.
# These variables are for future backend integration.

# Application mode: "local" (current) or "api" (future)
VITE_APP_MODE=local

# Base URL for your future backend API
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Feature flags for demo
VITE_ENABLE_DEMO_DATA=true
VITE_ENABLE_PRO_DEMO=true

# Optional: Sentry / monitoring (future)
# VITE_SENTRY_DSN=

# Optional: Analytics (future)
# VITE_POSTHOG_KEY=
